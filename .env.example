# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Settings (local development)
DB_NAME=silver_jewellery_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Database URL (production — Render/Neon — takes priority over DB_* vars above)
# DATABASE_URL=postgresql://user:password@host/dbname

# Frontend URL (added to CORS_ALLOWED_ORIGINS in production)
# FRONTEND_URL=https://your-app.pages.dev

# Cloudinary (production media storage — prevents image loss on Render restarts)
# Get from: https://cloudinary.com → Dashboard → API Keys
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Razorpay Settings
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Gemini AI — chatbot (free tier: 1M tokens/day)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
